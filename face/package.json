{
  "name": "@openhead/face",
  "version": "0.1.0",
  "private": true,
  "description": "OpenHead face engine: TypeScript + Canvas 2D, themes as data.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "gen:types": "node scripts/gen-types.mjs",
    "dev": "npm run gen:types && vite",
    "typecheck": "npm run gen:types && tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "gallery": "node scripts/gallery.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  }
}
