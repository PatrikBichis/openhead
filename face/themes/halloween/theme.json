{
  "name": "halloween",
  "version": "0.1.0",
  "title": "Halloween",
  "description": "Image-based jack-o'-lantern eyes and grin with a green glow. Exists to exercise the image path of the renderer.",
  "palette": {
    "bg": "#0E0A12",
    "sclera": "#0E0A12",
    "iris": "#7CFF4F",
    "pupil": "#0E0A12",
    "lid": "#0E0A12",
    "mouth": "#7CFF4F",
    "teeth": "#0E0A12",
    "accent": "#5BFF2E"
  },
  "shapes": {
    "eye": { "image": "assets/eye.svg", "anchor": [0.5, 0.55], "scale": 1.1 },
    "mouth": { "image": "assets/mouth.svg", "scale": 1.2 }
  },
  "layout": { "eye_spacing": 0.5, "eye_size": 0.3, "eye_y": 0.18, "mouth_width": 0.5, "mouth_y": -0.34 },
  "render": { "stroke": 0, "glow": 0.6, "scanlines": true, "pixelate": 0 },
  "idle": {
    "blink_interval_ms": [4000, 9000],
    "blink_duration_ms": 420,
    "saccade_interval_ms": [1200, 3500],
    "saccade_amplitude": 0.2,
    "breath_period_ms": 4500,
    "breath_amplitude": 0.1
  },
  "envelope": { "gain": 1.3, "gamma": 0.7, "attack_ms": 20, "release_ms": 120 },
  "resting_emotion": "mischievous"
}
