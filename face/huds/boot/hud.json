{
  "name": "boot",
  "title": "Boot",
  "version": "0.2.0",
  "font": "mono",
  "color": "#7dff8a",
  "accent": "#d6ffd9",
  "shadow": "#002a08",
  "tint": { "color": "#001a06", "opacity": 0.45 },
  "scanlines": { "opacity": 0.1, "spacing": 3 },
  "vignette": 0.3,
  "boxes": { "style": "bracket", "width": 2, "label": "{id}" },
  "lock": { "style": "corners", "label": "LOCK", "blink_ms": 700 },
  "boot": {
    "lines": [
      "HEAD.SYS",
      "LOAD FACE ENGINE",
      "OPTICS CHECK",
      "VISION.DRV",
      "GAZE SERVO MAP",
      "MOTION SENSORS",
      "PAIRING TABLE",
      "EMOTION SET 28",
      "TRACKER BUFFER",
      "PARITY SET",
      "SYSTEM STATUS",
      "OK"
    ],
    "ms_per_line": 140
  },
  "blocks": [
    { "at": "bottom-right", "lines": ["TRACKING {faces}", "TARGET {target}"], "size": 0.85 }
  ]
}
