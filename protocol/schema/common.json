{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Common",
  "description": "Shared definitions referenced by the other schemas.",
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version, MAJOR.MINOR.PATCH."
    },
    "unit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "signed_unit": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$",
      "description": "Lower-case identifier used for themes and emotions."
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600000
    },
    "thermal_state": {
      "type": "string",
      "enum": [
        "nominal",
        "fair",
        "serious",
        "critical"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "idle",
        "sensing",
        "capture"
      ],
      "description": "Camera ownership mode. Only `idle` is supported in 0.1."
    },
    "view": {
      "type": "string",
      "enum": [
        "face",
        "image",
        "video",
        "web",
        "camera"
      ],
      "description": "What fills the screen."
    },
    "topic": {
      "type": "string",
      "enum": [
        "imu",
        "status",
        "log",
        "faces",
        "pose"
      ],
      "description": "Subscribable stream. `faces` needs mode `capture` or `sensing`, `pose` needs `sensing`; `gps` and `env` arrive later."
    },
    "log_level": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "notice",
        "warning",
        "error",
        "fault"
      ]
    }
  }
}
