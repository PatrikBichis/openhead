{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expressions",
  "description": "A theme's `expressions.json`: a face parameter preset per shared emotion name, plus theme-specific ones under `extra`. Only `neutral` is required and must set every parameter; missing shared names fall back to it. Parameters a preset leaves out keep the neutral value.",
  "type": "object",
  "properties": {
    "neutral": { "$ref": "#/$defs/params" },
    "happy": { "$ref": "#/$defs/params" },
    "curious": { "$ref": "#/$defs/params" },
    "thinking": { "$ref": "#/$defs/params" },
    "surprised": { "$ref": "#/$defs/params" },
    "sad": { "$ref": "#/$defs/params" },
    "angry": { "$ref": "#/$defs/params" },
    "sleepy": { "$ref": "#/$defs/params" },
    "scared": { "$ref": "#/$defs/params" },
    "mischievous": { "$ref": "#/$defs/params" },
    "extra": {
      "type": "object",
      "propertyNames": { "$ref": "common.json#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/params" },
      "description": "Theme-specific expressions, e.g. `cackle`."
    }
  },
  "required": ["neutral"],
  "additionalProperties": false,
  "$defs": {
    "params": {
      "type": "object",
      "description": "Face parameters. Eyes and mouth in [0, 1] or [-1, 1]; global values normalised.",
      "properties": {
        "open_l": { "$ref": "common.json#/$defs/unit" },
        "open_r": { "$ref": "common.json#/$defs/unit" },
        "tilt_l": { "$ref": "common.json#/$defs/signed_unit" },
        "tilt_r": { "$ref": "common.json#/$defs/signed_unit" },
        "pupil": { "$ref": "common.json#/$defs/unit" },
        "gaze_x": { "$ref": "common.json#/$defs/signed_unit" },
        "gaze_y": { "$ref": "common.json#/$defs/signed_unit" },
        "squint": { "$ref": "common.json#/$defs/unit" },
        "open": { "$ref": "common.json#/$defs/unit", "description": "Mouth opening." },
        "width": { "$ref": "common.json#/$defs/unit", "description": "Mouth width." },
        "curve": { "$ref": "common.json#/$defs/signed_unit", "description": "Smile (+) or frown (-)." },
        "asym": { "$ref": "common.json#/$defs/signed_unit" },
        "teeth": { "$ref": "common.json#/$defs/unit" },
        "head_tilt": { "$ref": "common.json#/$defs/signed_unit" },
        "breath_rate": { "$ref": "common.json#/$defs/unit" },
        "blink_rate": { "$ref": "common.json#/$defs/unit" },
        "jitter": { "$ref": "common.json#/$defs/unit" }
      },
      "additionalProperties": false
    }
  }
}
