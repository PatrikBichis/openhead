{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SystemStatus",
  "description": "Current status, same content as the `status` topic.",
  "type": "object",
  "allOf": [{ "$ref": "../command.json" }],
  "properties": {
    "type": { "const": "system.status" }
  },
  "required": ["type"],
  "unevaluatedProperties": false,
  "$defs": {
    "result": { "$ref": "../topics/status.json#/$defs/payload" }
  }
}
