# Copy to .env and fill in. .env is git-ignored; never commit real values.
# The same names are used as GitHub Actions secrets/variables (see docs/ios.md).

# --- Apple / TestFlight (only needed to build signed iOS locally or to
# --- prepare GitHub secrets; the TestFlight workflow reads repository secrets) ---

# Variables (not secret)
APPLE_TEAM_ID=
IOS_BUNDLE_ID=
IOS_SCHEME=OpenHead

# App Store Connect API key. Role must be Admin: App Manager can read but cannot
# create bundle IDs, certificates or profiles (tools/apple_setup.py).
# Key IDs and issuer ID are not secret; the .p8 file is.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Path to the .p8 locally; in GitHub the secret holds the file contents
ASC_PRIVATE_KEY_PATH=
# App Store Connect app id (not secret); filled by tools/apple_setup.py
ASC_APP_ID=

# Apple Distribution certificate (.p12) and App Store provisioning profile.
# Created by tools/apple_setup.py in ~/.appstoreconnect/openhead/.
# Locally: paths to the files. In GitHub: base64 of the files
# (APPLE_DIST_CERT_P12_B64, APPLE_PROVISIONING_PROFILE_B64).
APPLE_DIST_CERT_ID=
APPLE_DIST_CERT_P12_PATH=
APPLE_DIST_CERT_PASSWORD=
APPLE_PROVISIONING_PROFILE_PATH=

# Password for the temporary keychain created by the TestFlight workflow
KEYCHAIN_PASSWORD=

# --- Host-side development ---

# Device to target with the CLI / MCP server: auto | localhost | head-01.local
OPENHEAD_DEVICE=auto
